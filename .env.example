NEXUS_URL=http://127.0.0.1:8787

# Zendesk private server-side app security
# Keep these values in your real .env only; never commit them.
ZENDESK_APP_PUBLIC_KEY=
ZENDESK_APP_AUDIENCE=
# Set true only for local ZCLI development. Keep false/unset in production.
NEXUS_ZENDESK_DEV_MODE=false
# Public HTTPS URL serving the ZAF app, normally your Cloudflare tunnel hostname.
NEXUS_ZENDESK_APP_URL=https://YOUR-NEXUS-HOSTNAME/zendesk/sidebar
